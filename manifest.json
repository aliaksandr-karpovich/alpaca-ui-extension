{
  "manifest_version": 3,
  "name": "Alpaca Markets extension",
  "description": "Alpaca markets extension",
  "version": "1.5",
  "permissions": ["storage"],
  "host_permissions": ["https://app.alpaca.markets/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alpaca Extension"
  },
  "web_accessible_resources": [
    {
      "resources": ["dark-mode.css"],
      "matches": ["https://app.alpaca.markets/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://app.alpaca.markets/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.alpaca.markets/*"],
      "js": ["chart-dark.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
